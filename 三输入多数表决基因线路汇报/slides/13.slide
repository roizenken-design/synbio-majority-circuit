                    <Text style={{ fontSize: 24, color: '#FFFFFF', fontWeight: 'bold' }}>{s.v}</Text>
                    <Text style={{ fontSize: 12, color: '#A9C3E8' }}>{s.k}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 40, top: 672, width: 1200, flexDirection: 'row', justifyContent: 'space-between' }}>
